#--------------------------------------------------------------------
# CodeIgniter 4 & Composer
#--------------------------------------------------------------------
/vendor/
/composer.phar
composer.lock

#--------------------------------------------------------------------
# Environment & Sensitive Credentials
#--------------------------------------------------------------------
.env
.env.test
.env.backup
.env.local
.env.production

#--------------------------------------------------------------------
# CodeIgniter Writable Data
#--------------------------------------------------------------------
/writable/cache/*
!/writable/cache/index.html
!/writable/cache/.gitkeep

/writable/debugbar/*
!/writable/debugbar/index.html
!/writable/debugbar/.gitkeep

/writable/logs/*
!/writable/logs/index.html
!/writable/logs/.gitkeep

/writable/session/*
!/writable/session/index.html
!/writable/session/.gitkeep

/writable/uploads/*
!/writable/uploads/index.html
!/writable/uploads/.gitkeep
/public/null/
ci_bekasin_session*

#--------------------------------------------------------------------
# Node.js & Frontend Assets
#--------------------------------------------------------------------
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm

#--------------------------------------------------------------------
# IDE & System Files
#--------------------------------------------------------------------
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

#--------------------------------------------------------------------
# Testing & Coverage
#--------------------------------------------------------------------
.phpunit.result.cache
/build/
/coverage/
