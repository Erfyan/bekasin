#--------------------------------------------------------------------
# ENVIRONMENT CONFIGURATION - BEKASIN-AJA.COM
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP CONFIGURATION
#--------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

#--------------------------------------------------------------------
# SUPABASE POSTGRESQL DATABASE CONFIGURATION
#--------------------------------------------------------------------
database.default.hostname = 'aws-0-ap-southeast-1.pooler.supabase.com'
database.default.database = 'postgres'
database.default.username = 'postgres.your-project-ref'
database.default.password = 'your-supabase-db-password'
database.default.DBDriver = 'Postgre'
database.default.DBPrefix = ''
database.default.port = 6543
database.default.charset = 'utf8'
database.default.schema = 'public'

#--------------------------------------------------------------------
# SUPABASE REST & STORAGE API CONFIGURATION
#--------------------------------------------------------------------
SUPABASE_URL = 'https://splspwbteapwnwaczxme.supabase.co'
SUPABASE_PUBLISHABLE_KEY = 'sb_publishable_OnWN8ytImmo1VmXepf4fog_YTJjyfQu'
SUPABASE_SECRET_KEY = 'sb_secret_your-secret-key-here'
SUPABASE_JWKS_URL = 'https://splspwbteapwnwaczxme.supabase.co/auth/v1/.well-known/jwks.json'
SUPABASE_STORAGE_BUCKET_PRODUCTS = 'product-images'
SUPABASE_STORAGE_BUCKET_AVATARS = 'avatars'
SUPABASE_STORAGE_BUCKET_TRANSACTIONS = 'transaction-proofs'

#--------------------------------------------------------------------
# SECURITY & SESSION
#--------------------------------------------------------------------
security.tokenName = 'csrf_bekasin_token'
security.headerName = 'X-CSRF-TOKEN'
security.cookieName = 'csrf_bekasin_cookie'
security.expires = 7200
security.regenerate = true
security.redirect = false
security.samesite = 'Lax'

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.cookieName = 'ci_bekasin_session'
session.expiration = 7200
session.savePath = null
session.matchIP = false
session.timeToUpdate = 300
session.regenerateDestroy = false
